# Release facts of Lowkey for the shared kit in Scripts/release (see Scripts/release/README.md).
# Public signed universal releases; no Sparkle/Homebrew updater.
APP_NAME=lowkey
APP_EXECUTABLE=Lowkey
ARCHIVE_PREFIX=lowkey
BUNDLE_ID=io.bobuk.lowkey
INSTALL_DIR=/Applications
GITHUB_REPO=bobuk-io/lowkey
LANDING_SLUG=lowkey
BUNDLE_CHECK=Scripts/check_bundle.swift
EXTRA_TESTS='bash Vendor/BobukKit/Scripts/check-vendor.sh'
# Packaging with Scripts/release/package.sh (see Scripts/release/README.md, "Packaging").
PACKAGE_MENU_BAR=0
PACKAGE_CATEGORY=public.app-category.productivity
PACKAGE_HELPERS=lowkeyctl:Helpers
PACKAGE_REFUSE_RUNNING=1
